generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

model User {
  id           String           @id @default(cuid())
  githubId     String?          @unique
  githubToken  String?
  name         String?
  email        String?          @unique
  password     String?
  image        String?
  plan                        Plan             @default(FREE)
  lemonSqueezySubscriptionId  String?          @unique
  lemonSqueezyCustomerId      String?
  accounts     Account[]
  sessions     Session[]
  repositories Repository[]
  reports      AnalysisReport[]
  ownedInvites TeamInvite[]     @relation("OwnedInvites")
  ownedMembers TeamMember[]     @relation("OwnedMembers")
  memberOf     TeamMember[]     @relation("MemberOf")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Repository {
  id          String           @id @default(cuid())
  userId      String?
  githubId    Int              @unique
  fullName    String
  name        String
  description String?
  language    String?
  isPrivate   Boolean          @default(false)
  url         String
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports     AnalysisReport[]

  @@index([userId])
}

model AnalysisReport {
  id            String          @id @default(cuid())
  userId        String?
  repositoryId  String
  status        AnalysisStatus  @default(PENDING)
  healthScore   Int?
  techStack     Json?
  criticalCount Int             @default(0)
  warningCount  Int             @default(0)
  infoCount     Int             @default(0)
  filesAnalyzed Int             @default(0)
  aiSummary             String?
  productionReadiness   Json?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  user          User?           @relation(fields: [userId], references: [id])
  repository    Repository      @relation(fields: [repositoryId], references: [id])
  sections      ReportSection[]

  @@index([userId])
}

model ReportSection {
  id         String          @id @default(cuid())
  reportId   String
  category   SectionCategory
  title      String
  severity   Severity
  issueCount Int             @default(0)
  order      Int
  report     AnalysisReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  issues     ReportIssue[]

  @@index([reportId])
}

model ReportIssue {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  description String
  severity    Severity
  filePath    String?
  lineNumber  Int?
  evidence    String?
  suggestion  String
  codeExample String?
  isAiAdded   Boolean  @default(false)
  section     ReportSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SectionCategory {
  CACHING
  DATABASE
  SECURITY
  ERROR_HANDLING
  SCALABILITY
  ARCHITECTURE
  DEPLOYMENT
}

enum Severity {
  CRITICAL
  WARNING
  INFO
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model TeamInvite {
  id         String       @id @default(cuid())
  ownerId    String
  token      String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?
  owner      User         @relation("OwnedInvites", fields: [ownerId], references: [id], onDelete: Cascade)
  membership TeamMember?

  @@index([ownerId])
  @@index([token])
}

enum MemberRole {
  EDITOR
  VIEWER
}

model TeamMember {
  id       String     @id @default(cuid())
  ownerId  String
  memberId String
  inviteId String     @unique
  role     MemberRole @default(EDITOR)
  joinedAt DateTime   @default(now())
  owner    User       @relation("OwnedMembers", fields: [ownerId], references: [id], onDelete: Cascade)
  member   User       @relation("MemberOf", fields: [memberId], references: [id], onDelete: Cascade)
  invite   TeamInvite @relation(fields: [inviteId], references: [id])

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
}
